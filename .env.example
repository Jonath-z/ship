# --- Ship control plane ---
SHIP_ENV=development
SHIP_VERSION=v0.1.0
SHIP_IMAGE_REGISTRY=ghcr.io/jonath-z
SHIP_HOSTNAME=localhost
SHIP_PUBLIC_URL=http://localhost:3000
SHIP_ALLOW_INSECURE_HTTP=true
SHIP_TRUST_FORWARDED_IP=false
SHIP_API_ADDR=:8080
SHIP_WORKER_ADDR=:8081
SHIP_LOG_LEVEL=info
SHIP_RUN_MIGRATIONS=true

# Optional host-port overrides for the development Compose stack.
SHIP_WEB_PORT=3000
SHIP_API_PORT=8080
SHIP_WORKER_PORT=8081
SHIP_POSTGRES_PORT=5432
SHIP_REDIS_PORT=6379

# Docker socket group on a Linux VPS. The installer detects this value.
DOCKER_GID=0

# --- Postgres (desired state, source of truth) ---
DATABASE_URL=postgres://ship:ship@localhost:5432/ship?sslmode=disable

# --- Redis (jobs, locks, events, cache — never desired state) ---
REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL container settings ---
POSTGRES_USER=ship
POSTGRES_PASSWORD=ship
POSTGRES_DB=ship

# Exact production data-service images. Updated only with a Ship release.
POSTGRES_IMAGE=postgres:16.14-alpine3.23
REDIS_IMAGE=redis:7.4.11-alpine3.21

# Development fallback. Production uses /opt/ship/keys/keyring.
# Generate a replacement with: openssl rand -hex 32
SHIP_MASTER_KEY=

# --- Session signing ---
SHIP_SESSION_SECRET=
SHIP_SESSION_IDLE_TTL=24h
SHIP_SESSION_ABSOLUTE_TTL=168h

# Development-only token: ship-development-first-run-token-1234567890
# Production stores the SHA-256 of the random token printed by the installer.
SHIP_FIRST_RUN_TOKEN_HASH=

# --- Ship-owned workspace for rendered Kamal config (SH-056) ---
SHIP_DATA_DIR=./data/ship

# --- GitHub integration (SH-110) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
