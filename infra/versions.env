# Versions used by Ship's production images and installer release bundle.
# Keep these exact: installed control planes must not change underneath a user.
SHIP_DEFAULT_VERSION=v0.1.0
GO_BUILDER_IMAGE=golang:1.23.12-alpine3.22
NODE_IMAGE=node:22.23.2-alpine3.23
RUBY_IMAGE=ruby:3.4.9-alpine3.23
KAMAL_VERSION=2.12.0
POSTGRES_IMAGE=postgres:16.14-alpine3.23
REDIS_IMAGE=redis:7.4.11-alpine3.21
